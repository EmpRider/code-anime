{
  "name": "@empirerider/code-anime",
  "version": "0.5.2",
  "description": "CodeGraph-grounded mock execution and value animation for AI agents through MCP",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "code-anime": "dist/index.js"
  },
  "files": [
    "dist",
    "public",
    "examples",
    "skills",
    "AGENTS.md"
  ],
  "scripts": {
    "dev": "node --watch --import tsx src/index.ts",
    "build": "node scripts/build.mjs",
    "start": "node dist/index.js",
    "demo": "node --import tsx scripts/demo.ts",
    "typecheck": "tsc --noEmit -p tsconfig.check.json",
    "check:scope": "node scripts/check-static-boundary.mjs",
    "test": "node --import tsx --test --test-concurrency=1 tests/*.test.ts tests/*.test.mjs",
    "test:browser": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run check:scope && npm run typecheck && npm run build && npm test && npm run format:check",
    "prepack": "npm run build",
    "package:check": "node scripts/verify-package.mjs"
  },
  "dependencies": {
    "@antv/x6": "3.1.8",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "cytoscape": "^3.34.4",
    "cytoscape-dagre": "^4.0.1",
    "dagre": "^0.8.5",
    "express": "^5.0.0",
    "tslib": "^2.8.1",
    "ws": "^8.22.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "elkjs": "0.12.0",
    "jsdom": "^30.1.2",
    "prettier": "^3.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "vite": "8.3.4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EmpRider/code-anime.git"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "license": "MIT",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "visualization",
    "ai",
    "code-flow"
  ],
  "author": "empirerider"
}
