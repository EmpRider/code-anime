{
  "name": "@empirerider/code-anime",
  "version": "0.1.0",
  "description": "An MCP server that turns agent-authored code flows into an interactive local animation.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "code-anime": "dist/index.js"
  },
  "files": [
    "dist",
    "public",
    "examples"
  ],
  "scripts": {
    "dev": "node --watch --import tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "demo": "node --import tsx scripts/demo.ts",
    "typecheck": "tsc --noEmit -p tsconfig.check.json",
    "test": "node --import tsx --test tests/*.test.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm test && npm run build && npm run format:check",
    "prepack": "npm run build",
    "package:check": "node scripts/verify-package.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "express": "^5.0.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "prettier": "^3.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EmpRider/code-anime.git"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "license": "MIT",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "visualization",
    "ai",
    "code-flow"
  ],
  "author": "empirerider"
}
